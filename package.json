{
  "name": "playwright-ts-unified-scaffold",
  "version": "2.0.0",
  "description": "Unified Playwright + TypeScript test scaffold: UI, API and AI/LLM testing (demo app: OrangeHRM)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:ui:all-browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:ai": "playwright test --project=ai",
    "test:golden": "playwright test --project=ai --grep @golden",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:trace": "playwright test --project=chromium --trace on",
    "test:flaky": "playwright test --project=chromium --repeat-each=3 --retries=0",
    "test:strict": "playwright test --project=chromium --retries=1 --fail-on-flaky-tests",
    "test:changed": "playwright test --only-changed",
    "test:last-failed": "playwright test --last-failed",
    "report": "playwright show-report",
    "eval:prompts": "promptfoo eval",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.7",
    "@langchain/openai": "^1.8.3",
    "@langchain/textsplitters": "^1.0.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "dotenv-flow": "^4.1.0",
    "openai": "^7.55.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
