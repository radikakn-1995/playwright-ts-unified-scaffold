# Copy this file to .env.qa and fill in the values.
# Real secrets (API keys) go only in .env.local, which is never committed.

# ---- OrangeHRM ----
BASE_URL=https://opensource-demo.orangehrmlive.com
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123
API_BASE_URL_PATH=/web/index.php/api/v2
DEFAULT_TIMEOUT=30000

# ---- LLM, Option A: Ollama on your laptop (free) ----
# First run:  ollama pull llama3.2   and   ollama pull nomic-embed-text
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
JUDGE_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ---- LLM, Option B: OpenAI / Azure OpenAI key from your organisation (put in .env.local) ----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-key
# LLM_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
